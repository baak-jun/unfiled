# Select: raon | openai | gemini | anthropic | deepseek | custom
AI_PROVIDER=raon
# Required for providers other than Raon: copy a chat model ID from your console.
AI_MODEL=raon-1-mini-preview
AI_API_KEY=
# Only for custom: include the API version path, but not /chat/completions.
AI_BASE_URL=
AI_MAX_TOKENS=2048
PORT=4173
# Legacy RAON_API_KEY is still accepted for AI_PROVIDER=raon.
